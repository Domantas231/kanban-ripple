ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kanban_db;Username=kanban_user;Password=kanban_password

# Frontend origin (used for CORS and email links)
Frontend__Url=http://localhost:5173

# JWT signing
Jwt__Issuer=Kanban.Api.Dev
Jwt__Audience=Kanban.Frontend.Dev
Jwt__Key=replace-with-a-long-random-string-min-32-chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Email (Console writes to stdout; replace with SMTP/SendGrid in prod)
Email__Provider=Console
Email__From=noreply@kanban.local

# Google OAuth + Drive Picker (required for /api/google/* endpoints)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match Google__RedirectUri exactly
Google__ClientId=your-client-id.apps.googleusercontent.com
Google__ClientSecret=your-client-secret
Google__RedirectUri=http://localhost:5231/api/google/callback

# File storage for attachments
# Provider options: S3 (MinIO or any S3-compatible), AzureBlob, or leave unset for a no-op store
FileStorage__Provider=S3
FileStorage__ServiceUrl=http://localhost:9000
FileStorage__AccessKey=minioadmin
FileStorage__SecretKey=minioadmin
FileStorage__BucketName=kanban-attachments
# For Azure Blob instead of S3/MinIO, set Provider=AzureBlob and uncomment:
# FileStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
