# Copy to e2e/.env (gitignored) and fill in. Defaults work for local dev.

# The primary E2E user provisioned by auth.setup.ts
E2E_USER_EMAIL=e2e-user@kanban.test
E2E_USER_PASSWORD=E2eUserPass!2024

# A second user used in cross-user tests (currently unused, reserved)
E2E_OTHER_EMAIL=e2e-other@kanban.test
E2E_OTHER_PASSWORD=E2eOtherPass!2024

# Override URLs if you run on non-default ports
E2E_FRONTEND_URL=http://localhost:5173
E2E_BACKEND_URL=http://localhost:5231

# Set to 1 to run firefox + webkit alongside chromium
PW_ALL_BROWSERS=
